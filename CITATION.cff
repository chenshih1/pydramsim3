version: "0.4.0"
date-released: "2026-08-25"
license: MIT
keywords:
  - DRAM
  - memory-simulation
  - computer-architecture
  - discrete-event-simulation
  - hardware-simulation
repository-code: "https://github.com/chenshih1/pydramsim3"
